# PostgreSQL
POSTGRES_USER="root"
POSTGRES_PASSWORD="root"
POSTGRES_DB="local"

# Drizzle
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}"

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Admin access
ADMIN_LOGIN_SLUG="secure-abc123"
ADMIN_ALLOWED_EMAILS="owner@example.com"
ADMIN_SESSION_COOKIE_NAME="admin_session"
ADMIN_SESSION_MAX_AGE="43200"
DEV_ADMIN_BYPASS="false"
ADMIN_SETUP_TOKEN=""

# Owner seed (pnpm db:seed-owner)
# OWNER_EMAIL defaults to the first entry in ADMIN_ALLOWED_EMAILS if omitted
OWNER_EMAIL=""
OWNER_PASSWORD=""

# GitHub OAuth
# https://www.better-auth.com/docs/authentication/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
